# Copy to .env and fill only the values you use. Never commit .env.

# Local OpenAI-compatible service. When omitted, the project reuses Pi's global model configuration.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:4141/v1
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_MODEL=

# Screenshots stay local by default. Set to 1 only when the selected Pi provider may receive them.
ANDROID_RESEARCH_ALLOW_CLOUD=0

# Optional Android configuration.
ANDROID_SERIAL=
ADB_PATH=
